# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/thegrand"

# Long random string used to sign admin session cookies (change in production!)
AUTH_SECRET="replace-with-a-long-random-secret-string"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@thegrand.local"
ADMIN_PASSWORD="ChangeMe@123"

# Where uploaded images are stored (served at /uploads/...)
UPLOAD_DIR="./uploads"
